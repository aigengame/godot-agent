{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigengame.dev/gda-balancing/research/schema2-genre-corpus-v1.schema.json",
  "title": "Schema 2.0 genre conformance research corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "game",
    "version_scope",
    "sources",
    "mechanics"
  ],
  "properties": {
    "artifact_kind": {"const": "schema2-genre-research-corpus"},
    "schema_version": {"const": 1},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "family", "archetype"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "family": {"enum": ["rpg", "roguelike", "cross-genre-control"]},
        "archetype": {"type": "string", "minLength": 1}
      }
    },
    "version_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "content_scope", "recorded_at"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_scope": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mechanic"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "version", "confidence", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "kind": {
          "enum": [
            "shipped_data",
            "open_source",
            "official_documentation",
            "runtime_observation",
            "community_reference",
            "research"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["primary", "corroborated", "provisional"]},
        "notes": {"type": "string"}
      }
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "families",
        "coverage_rows",
        "source_refs",
        "quantities",
        "state_slots",
        "operations",
        "oracle_vectors"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quantity",
              "resource",
              "action",
              "check",
              "combat",
              "effect",
              "build",
              "progression",
              "economy",
              "generation",
              "encounter",
              "run",
              "turn",
              "spatial",
              "evidence"
            ]
          }
        },
        "coverage_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(RPG|ROGUE)-[A-Z]+-[0-9]{2}$"}
        },
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "quantities": {
          "type": "array",
          "items": {"$ref": "#/$defs/quantity"}
        },
        "state_slots": {
          "type": "array",
          "items": {"$ref": "#/$defs/stateSlot"}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        },
        "oracle_vectors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/oracle"}
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "representation",
        "kind",
        "unit",
        "role",
        "domain",
        "rounding",
        "cap",
        "source_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "representation": {"enum": ["Int", "Fixed", "Decimal", "Float", "Bool", "Enum"]},
        "kind": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "role": {
          "enum": ["constant", "parameter", "input", "state", "derived", "output", "random_variable"]
        },
        "domain": {"type": "string", "minLength": 1},
        "rounding": {"type": ["string", "null"]},
        "cap": {"type": ["string", "null"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "stateSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value_type", "scope", "initial", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "value_type": {"type": "string", "minLength": 1},
        "scope": {
          "enum": ["model", "meta", "run", "encounter", "entity", "action", "effect"]
        },
        "initial": {},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "outcomes",
        "reads",
        "writes",
        "signals",
        "schedules",
        "rng_streams",
        "ordering",
        "source_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "signals": {"type": "array", "items": {"type": "string"}},
        "schedules": {"type": "array", "items": {"type": "string"}},
        "rng_streams": {"type": "array", "items": {"type": "string"}},
        "ordering": {"type": "string"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "inputs", "expected_observations", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "kind": {"enum": ["positive", "outcome", "refusal", "boundary", "determinism"]},
        "inputs": {},
        "expected_observations": {},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    }
  }
}
