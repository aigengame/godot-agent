    "shift_left": {"fields": ["op", "left", "right"]},
    "shift_right": {"fields": ["op", "left", "right"]},
    "concat": {"fields": ["op", "items"]},
    "to_string": {"fields": ["op", "value"]},
    "sha256_u32": {"fields": ["op", "value"]},
    "has_key": {"fields": ["op", "map", "key"]},
    "lookup": {"fields": ["op", "map", "key"]},
    "keys_equal": {"fields": ["op", "left", "right"]},
    "type_map_matches": {"fields": ["op", "values", "signature"]},
    "set_equal": {"fields": ["op", "left", "right"]},
    "program_effects": {"fields": ["op", "program"]},
    "evaluate_program": {"fields": ["op", "program", "environment"]},
    "select_unique": {"fields": ["op", "candidates", "direction"]},
    "lex_gt": {"fields": ["op", "left", "right"]},
    "assoc_path": {"fields": ["op", "map", "path", "value"]},
    "call_kernel": {"fields": ["op", "law", "arguments"]},
    "effect": {"fields": ["op", "kind", "arguments"]}
  },
  "effect_kinds": {
    "state.read": {"law": "effect.state_read"},
    "state.write": {"law": "effect.state_write"},
    "random.sample": {"law": "effect.random_sample"},
    "metric.emit": {"law": "effect.metric_emit"},
    "signal.emit": {"law": "effect.signal_emit"},
    "event.schedule": {"law": "effect.event_schedule"}
  },
  "admission_diagnostics": {
    "identity_mismatch": {"code": "kernel.identity-mismatch", "stage": "ingress"},
    "kernel_binding_mismatch": {"code": "kernel.ldb-binding-mismatch", "stage": "ingress"},
    "malformed_artifact": {"code": "kernel.malformed-artifact", "stage": "ingress"},
    "unknown_opcode": {"code": "kernel.unknown-opcode", "stage": "static"},
    "node_shape_invalid": {"code": "kernel.node-shape-invalid", "stage": "static"},
    "law_missing": {"code": "kernel.law-missing", "stage": "static"},
    "law_contract": {"code": "kernel.law-contract-violation", "stage": "static"},
    "resource_exhausted": {"code": "kernel.resource-exhausted", "stage": "static"}
  },
  "laws": {
    "effect.state_read": {
      "parameters": {"path": "Str"}, "result": "Record", "effects": [], "refusals": [],
      "resource_accounting": {"unit": "vm_step", "maximum": 8},
      "body": {"op": "object", "fields": {"disposition": {"op": "literal", "value": "read_snapshot"}, "path": {"op": "var", "name": "path"}}}
    },
    "effect.state_write": {
      "parameters": {"path": "Str", "value": "Value"}, "result": "Record", "effects": [], "refusals": [],
      "resource_accounting": {"unit": "vm_step", "maximum": 8},
      "body": {"op": "object", "fields": {"disposition": {"op": "literal", "value": "buffer_write"}, "path": {"op": "var", "name": "path"}, "value": {"op": "var", "name": "value"}}}
    },
    "effect.random_sample": {
      "parameters": {"bound": "Int", "stream": "Str"}, "result": "Record", "effects": [], "refusals": [],
      "resource_accounting": {"unit": "vm_step", "maximum": 10},
      "body": {"op": "object", "fields": {"bound": {"op": "var", "name": "bound"}, "disposition": {"op": "literal", "value": "sample"}, "stream": {"op": "var", "name": "stream"}}}
    },
    "effect.metric_emit": {
      "parameters": {"metric": "Str", "value": "Value"}, "result": "Record", "effects": [], "refusals": [],
      "resource_accounting": {"unit": "vm_step", "maximum": 8},
      "body": {"op": "object", "fields": {"disposition": {"op": "literal", "value": "buffer_metric"}, "metric": {"op": "var", "name": "metric"}, "value": {"op": "var", "name": "value"}}}
