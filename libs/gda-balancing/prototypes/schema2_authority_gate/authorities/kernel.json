    "max_vm_steps": 8192
  },
  "wire_types": ["Any", "Bool", "Int", "List", "Record", "Str", "Unit", "Value"],
  "meta_opcodes": {
    "literal": {"fields": ["op", "value"]},
    "var": {"fields": ["op", "name"]},
