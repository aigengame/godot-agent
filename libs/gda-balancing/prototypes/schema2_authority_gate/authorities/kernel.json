    "eq": {"fields": ["op", "left", "right"]},
    "not": {"fields": ["op", "value"]},
    "and": {"fields": ["op", "items"]},
    "or": {"fields": ["op", "items"]},
    "lt": {"fields": ["op", "left", "right"]},
    "le": {"fields": ["op", "left", "right"]},
    "ge": {"fields": ["op", "left", "right"]},
    "add": {"fields": ["op", "left", "right"]},
    "sub": {"fields": ["op", "left", "right"]},
    "mod": {"fields": ["op", "left", "right"]},
