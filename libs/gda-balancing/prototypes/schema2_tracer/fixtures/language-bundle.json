      "id": "game.combat.resolve-damage@1",
      "inputs": [
        {"name": "target", "type": "EntityRef:Combatant"},
        {"name": "power", "type": "Quantity:damage"},
        {"name": "check", "type": "Record:CheckOutcome"}
      ],
      "package": "game.combat",
      "primitive": "combat.staged-damage",
      "result": "Record:DamageOutcome"
    },
    {
      "effects": ["write:state"],
      "id": "game.resource.commit@1",
      "inputs": [{"name": "reservation", "type": "Record:Reservation"}],
      "package": "game.resource",
      "primitive": "resource.commit",
      "result": "Unit"
    },
    {
      "effects": ["read:state", "write:state"],
      "id": "game.effect.apply@1",
      "inputs": [{"name": "target", "type": "EntityRef:Combatant"}],
      "package": "game.effect",
      "primitive": "effect.apply-marker",
      "result": "Unit"
    },
    {
      "effects": ["schedule:event"],
