      "inputs": [
        {"name": "target", "type": "EntityRef:Combatant"},
        {"name": "priority", "type": "Int"}
      ],
      "package": "core",
      "primitive": "runtime.schedule-observation",
      "result": "Unit"
    },
    {
      "effects": ["schedule:event"],
      "id": "core.runtime.schedule-transition@1",
      "inputs": [
        {"name": "handler", "type": "Enum:handler"},
        {"name": "priority", "type": "Int"}
      ],
      "package": "core",
      "primitive": "runtime.schedule-transition",
      "result": "Unit"
    },
    {
      "effects": ["read:state"],
      "id": "experiment.balance.observe@1",
      "inputs": [{"name": "target", "type": "EntityRef:Combatant"}],
      "package": "experiment.balance",
      "primitive": "experiment.observe",
      "result": "Unit"
    }
  ],
  "packages": [
    {"id": "core", "version": "1.0.0"},
    {"id": "experiment.balance", "version": "1.0.0"},
    {"id": "game.check", "version": "1.0.0"},
    {"id": "game.combat", "version": "1.0.0"},
    {"id": "game.effect", "version": "1.0.0"},
    {"id": "game.entity", "version": "1.0.0"},
    {"id": "game.query", "version": "1.0.0"},
    {"id": "game.resource", "version": "1.0.0"}
  ],
  "rules": [
