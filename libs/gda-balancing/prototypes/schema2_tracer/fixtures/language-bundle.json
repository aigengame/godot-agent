    {"conclusion": {"judgment": "operation-lowered", "result": "accept"}, "diagnostic": {"code": "schema2.resolution.lowering-refused", "stage": "resolution"}, "id": "lower.operation", "phase": "lowering", "premises": [{"op": "truthy", "value": {"fact": "operation_admitted"}}, {"op": "truthy", "value": {"fact": "primitive_present"}}]}
  ],
  "runtime_profiles": [
