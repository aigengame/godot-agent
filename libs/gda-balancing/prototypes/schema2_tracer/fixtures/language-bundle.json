    {"conclusion": {"judgment": "value-inhabits", "result": "accept"}, "diagnostic": {"code": "schema2.static.value-type-mismatch", "stage": "static"}, "id": "type.value-inhabits", "phase": "typing", "premises": [{"op": "truthy", "value": {"fact": "valid"}}]},
    {"conclusion": {"judgment": "types-equal", "result": "accept"}, "diagnostic": {"code": "schema2.static.type-mismatch", "stage": "static"}, "id": "type.equal", "phase": "typing", "premises": [{"left": {"fact": "actual"}, "op": "equal", "right": {"fact": "expected"}}]},
    {"conclusion": {"judgment": "add-compatible", "result": "accept"}, "diagnostic": {"code": "schema2.static.add-type-mismatch", "stage": "static"}, "id": "type.add-compatible", "phase": "typing", "premises": [{"op": "truthy", "value": {"fact": "valid"}}]},
    {"conclusion": {"judgment": "expression-typed", "result": "accept"}, "diagnostic": {"code": "schema2.static.unknown-expression", "stage": "static"}, "id": "type.expression", "phase": "typing", "premises": [{"op": "truthy", "value": {"fact": "valid"}}]},
    {"conclusion": {"judgment": "call-arguments-closed", "result": "accept"}, "diagnostic": {"code": "schema2.static.call-arguments", "stage": "static"}, "id": "type.call-arguments", "phase": "typing", "premises": [{"left": {"fact": "actual"}, "op": "set_equal", "right": {"fact": "expected"}}]},
    {"conclusion": {"judgment": "call-typed", "result": "accept"}, "diagnostic": {"code": "schema2.static.call-type-mismatch", "stage": "static"}, "id": "type.call", "phase": "typing", "premises": [{"left": {"fact": "actual"}, "op": "equal", "right": {"fact": "expected"}}]},
    {"conclusion": {"judgment": "effects-exact", "result": "accept"}, "diagnostic": {"code": "schema2.static.effect-mismatch", "stage": "static"}, "id": "effect.declared", "phase": "effects", "premises": [{"left": {"fact": "actual"}, "op": "set_equal", "right": {"fact": "expected"}}]},
    {"conclusion": {"judgment": "package-bound", "result": "accept"}, "diagnostic": {"code": "schema2.resolution.package-conflict", "stage": "resolution"}, "id": "package.exact", "phase": "resolution", "premises": [{"op": "truthy", "value": {"fact": "admitted"}}, {"left": {"fact": "actual_version"}, "op": "equal", "right": {"fact": "expected_version"}}, {"op": "truthy", "value": {"fact": "unique"}}]},
    {"conclusion": {"judgment": "capability-bound", "result": "accept"}, "diagnostic": {"code": "schema2.resolution.capability-missing", "stage": "resolution"}, "id": "package.capability", "phase": "resolution", "premises": [{"container": {"fact": "locked"}, "item": {"fact": "owner"}, "op": "contains"}]},
