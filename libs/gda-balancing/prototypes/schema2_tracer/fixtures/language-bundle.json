    {"conclusion": {"judgment": "name-resolved", "result": "accept"}, "diagnostic": {"code": "schema2.static.unresolved-symbol", "stage": "static"}, "id": "resolution.name", "phase": "resolution", "premises": [{"container": {"fact": "names"}, "item": {"fact": "requested"}, "op": "contains"}]},
