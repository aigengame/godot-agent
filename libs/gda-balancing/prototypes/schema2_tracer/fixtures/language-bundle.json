  "types": ["Bool", "EntityRef:Combatant", "Enum:handler", "Enum:resource-slot", "Enum:stream", "Enum:team", "Int", "Quantity:damage", "Quantity:health", "Quantity:mana", "Record:CheckOutcome", "Record:DamageOutcome", "Record:Reservation"]
