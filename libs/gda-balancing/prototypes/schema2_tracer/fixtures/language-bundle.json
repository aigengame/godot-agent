      "id": "exact-rpg-tracer-v1",
      "named_streams": ["combat.critical", "combat.hit"],
      "numeric_profile": "exact-integer-v1",
      "rng": {"algorithm": "sha256-counter-v1", "mapping": "uint64-be-mod-100"},
      "scheduler": {"phase_order": ["input", "transition", "observation"], "priority": "descending", "sequence": "ascending", "time": "ascending"}
    }
